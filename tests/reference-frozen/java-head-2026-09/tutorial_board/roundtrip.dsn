        37860.0 -154940.0
        256780.0 -154940.0
        271780.0 -139940.0
        271780.0 -37860.0
        256780.0 -22860.0
        37860.0 -22860.0
        22860.0 -37860.0
        22860.0 -139940.0
      )
    )
    (via "Via[0-1]_600:300_um" "Via[0-1]_600:300_um")
    (rule
      (width 200.0)
      (clearance 200.0)
      (clearance 100.0 (type smd_to_turn_gap))
      (clearance 50.0 (type smd))
    )
    (snap_angle 
      fortyfive_degree
    )
    (control
      (via_at_smd off)
    )
  )
  (placement
  )
  (library
