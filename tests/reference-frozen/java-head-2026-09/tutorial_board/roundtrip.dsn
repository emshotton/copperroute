    (generated_by_freerouting)
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
    )
    (layer B.Cu
      (type signal)
    )
    (boundary
      (rect pcb 22760.0 -155040.0 271880.0 -22760.0)
    )
    (boundary
