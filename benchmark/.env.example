# Copy this file to `.env` and fill in your own values. `.env` is gitignored -- nothing
# host-specific belongs in the repo itself. Every script under scripts/ and bench/paths.py
# load `.env` from the benchmark directory automatically if it exists; a variable already set in your
# real shell environment always wins over the same variable in `.env`.
#
# Nothing in here is required to run the suite locally against ../../freerouting -- every
# variable has a built-in default (documented below) that matches this suite's own
# development setup. You only need to set anything if your machine is laid out differently,
# or you're driving a remote host (see scripts/remote-*.sh and the "Remote runs" section of README.md).

### Local tool paths (bench/paths.py) ###############################################

# Path to the built Java executable jar.
# Default: ../../freerouting/build/libs/freerouting-current-executable.jar
#FREEROUTING_JAR=

# The `java` executable used to run freerouting.
# Default: highest-version JDK under ~/.gradle/jdks, else `java` on $PATH
#FREEROUTING_JAVA=

# kicad-cli, used by the KiCad referee (PCBench boards).
# Default (macOS): /Applications/KiCad/KiCad.app/Contents/MacOS/kicad-cli
#COPPERROUTE_KICAD_CLI=

# KiCad's bundled python3 (needs `import pcbnew`), used by the KiCad referee.
# Default (macOS): /Applications/KiCad/KiCad.app/Contents/Frameworks/Python.framework/Versions/Current/bin/python3
#COPPERROUTE_KICAD_PYTHON=

# External `time` binary used to capture wall/CPU/RSS (BSD time on macOS, GNU time on Linux).
# Default: /usr/bin/time
#COPPERROUTE_TIME=

### bench run (bench/cli.py) #########################################################

# Candidates TOML file `bench run` loads --candidates from, when --candidates-file isn't
# passed explicitly. Set this to candidates.remote.toml on a host without a ../../freerouting
# checkout (scripts/remote-run.sh sets this itself when launching remotely).
# Default: candidates.toml next to pyproject.toml
#BENCH_CANDIDATES=

### Remote NixOS host (scripts/remote-*.sh) ##########################################

# The remote host to drive, e.g. user@hostname. Required by scripts/remote-run.sh,
# scripts/remote-corpus.sh, and scripts/remote-setup.sh unless you pass HOST as their first
# argument instead -- set it here so you don't have to type it every time.
# No default -- the scripts refuse to run with neither this nor a HOST argument.
#BENCH_REMOTE_HOST=you@your-nixos-host

# Remote checkout directory (relative to HOST's home, or absolute) that scripts/remote-run.sh
# and scripts/remote-corpus.sh rsync the suite into and run `bench` from.
# Default: freerouting-bench
#BENCH_REMOTE_DIR=freerouting-bench

# Path (on HOST) to the KiCad-Python wrapper that scripts/remote-setup.sh creates --
# Nix's own python3 with PYTHONPATH pointed at KiCad's pcbnew module. Only needs setting if
# you moved/renamed the wrapper scripts/remote-setup.sh writes.
# Default: $HOME/freerouting-bench-env/kicad-python (expanded on HOST, i.e. HOST's $HOME)
#BENCH_REMOTE_KICAD_PYTHON=$HOME/freerouting-bench-env/kicad-python

# Path (on HOST) to GNU time, used to capture wall/CPU/RSS for remote runs.
# Default: /run/current-system/sw/bin/time (where NixOS ships it)
#BENCH_REMOTE_TIME=/run/current-system/sw/bin/time

# Space-separated `nix shell` package references installed on HOST for `bench run`/
# `bench corpus` (jdk25 for freerouting, uv + python312 to run the suite itself, xvfb-run
# for KiCad's wx-based import scripts under a headless display).
# Default: nixpkgs#jdk25 nixpkgs#uv nixpkgs#python312 nixpkgs#xvfb-run
#BENCH_REMOTE_NIX_PACKAGES=nixpkgs#jdk25 nixpkgs#uv nixpkgs#python312 nixpkgs#xvfb-run

# Local ../../freerouting checkout scripts/remote-run.sh reads the jar and commit sha from
# before rsyncing to HOST (HOST itself never needs a Java repo checkout of its own -- see
# candidates.remote.toml). Relative paths resolve against benchmark/.
# Default: ../../freerouting
#BENCH_REMOTE_JAVA_REPO=../../freerouting
