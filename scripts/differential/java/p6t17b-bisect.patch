+  /** Pre-order walk of the whole tree: leaf/inner flag plus each node's bounding octagon. */
+  void p6t17bDumpTree() {
+    if (this.root == null) return;
+    java.util.ArrayDeque<TreeNode> stack = new java.util.ArrayDeque<>();
+    stack.push(this.root);
+    while (!stack.isEmpty()) {
+      TreeNode n = stack.pop();
+      boolean leaf = n instanceof Leaf;
+      System.err.println(
+          "TREENODE k=" + app.freerouting.autoroute.maze.MazeSearchEngine.P6T17B_K
+              + " " + (leaf ? "L" : "I")
+              + " " + p6t17bOct(n.boundingShape.boundingOctagon()));
+      if (!leaf) {
+        stack.push(((InnerNode) n).secondChild);
+        stack.push(((InnerNode) n).firstChild);
+      }
+    }
+  }
+  // ---- end P6T17b ------------------------------------------------------------------------------
