+  static String p7t14bShape(TileShape shape) {
+    if (shape == null) {
+      return "null";
+    }
+    StringBuilder rendered = new StringBuilder("{");
+    for (int i = 0; i < shape.borderLineCount(); i++) {
+      if (i > 0) {
+        rendered.append(';');
+      }
+      app.freerouting.geometry.planar.FloatPoint corner = shape.cornerApprox(i);
+      rendered.append(String.format(java.util.Locale.ROOT, "%.3f,%.3f", corner.x, corner.y));
+    }
+    return rendered.append('}').toString();
+  }
