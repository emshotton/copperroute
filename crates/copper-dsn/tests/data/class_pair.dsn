(pcb class_pair.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)))
    (layer B.Cu (type signal) (property (index 1)))
    (boundary
      (path pcb 0  0 0  100000 0  100000 100000  0 100000  0 0)
    )
    (rule (width 250) (clearance 200))
  )
  (library
    (padstack VA (shape (circle F.Cu 800)) (shape (circle B.Cu 800)) (attach off))
  )
  (network
    (net N1)
    (net N2)
    (net N3)
    (class Alpha N1
      (circuit
        (length 5000 1000)
        (use_layer F.Cu)
      )
      (rule (width 300) (clearance 300))
      (layer_rule F.Cu (rule (width 600)))
    )
    (class Beta N2
      (rule (width 400) (clearance 400))
    )
    (class Gamma N3
      (rule (width 500) (clearance 500))
    )
    (class_class
      (classes Alpha Beta Gamma)
      (rule (clearance 777))
    )
  )
)
